# App
NODE_ENV=development
PORT=3001
APP_STATUS=operational
APP_VERSION=0.0.1

# MongoDB
MONGO_URI=mongodb://localhost:27017/api_db

# Api key Auth
API_KEY=change_this_for_your_api_key

# JWT Auth
JWT_ACCESS_SECRET=change_this_to_a_very_secure_random_string_at_least_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change_this_to_a_very_secure_random_string_at_least_32_chars
JWT_REFRESH_EXPIRATION=1d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Mailer
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_SECURE=false
MAILER_AUTH_USER=your-email@gmail.com
MAILER_AUTH_PASS=your-app-specific-password
MAILER_EMAIL_FROM_NAME="Merk2 Team"
MAILER_EMAIL_FROM_DOMAIN=noreply@merk2.com

# Business Module
BUSINESS_MAX_EMPLOYEES=50
BUSINESS_MAX_PRODUCTS=1000

# Products Module
PRODUCT_MAX_IMAGES=10

# Users Module
USER_PHONE_VERIFICATION_REQUIRED=false

# VerificationCode Module
VERIFICATION_CODE_EXPIRES_HOURS=1

# Expo Push Notifications (legacy / opcional)
EXPO_ACCESS_TOKEN=

# Firebase Admin — FCM nativo (mismo proyecto que google-services.json de la app)
# Preferido: ruta al JSON de service account (nunca lo subas a git)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternativa: variables sueltas
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
